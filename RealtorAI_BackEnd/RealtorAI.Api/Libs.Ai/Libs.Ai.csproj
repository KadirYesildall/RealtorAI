<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The evaluation harness measures a model before it is enabled, so it cannot go through
      AiService (which dispatches only to enabled entries). It reuses AiService's own message
      building, request options and failure classification instead, so an evaluated model is
      called exactly as production would call it. Those helpers stay internal: no other caller
      has any business assembling a model request outside AiService.
    -->
    <InternalsVisibleTo Include="AiEval" />
  </ItemGroup>

</Project>
