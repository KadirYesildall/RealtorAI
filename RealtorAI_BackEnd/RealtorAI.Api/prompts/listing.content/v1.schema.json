{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Listing content result",
  "description": "Structured field values or text variants for one listing (FR-012, FR-013, FR-014). Every sentence carries the listing_field ids it rests on, which is what lets grounding check a claim instead of trusting it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["variants"],
  "properties": {
    "structured": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structured mode only. Values outside the RESO lookups and the MLS's mapping are dropped after validation.",
      "properties": {
        "InteriorFeatures": { "$ref": "#/$defs/lookupValues" },
        "Appliances": { "$ref": "#/$defs/lookupValues" },
        "Flooring": { "$ref": "#/$defs/lookupValues" },
        "ParkingFeatures": { "$ref": "#/$defs/lookupValues" },
        "PoolFeatures": { "$ref": "#/$defs/lookupValues" },
        "View": { "$ref": "#/$defs/lookupValues" }
      }
    },
    "variants": {
      "type": "array",
      "maxItems": 3,
      "description": "Text mode only: the alternatives of the requested kind.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sentences"],
        "properties": {
          "sentences": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "supportingFieldIds"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "supportingFieldIds": {
                  "type": "array",
                  "maxItems": 20,
                  "items": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "lookupValues": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    }
  }
}
