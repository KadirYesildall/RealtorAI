<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The test projects assert on internal composition details on purpose: that EF migrations
      are replaced by a throwing migrator, and that the JWT setup validates what it claims to.
      Making those types public purely to test them would widen the API surface of the host
      assembly for no caller's benefit.
    -->
    <InternalsVisibleTo Include="Tests.unit" />
    <InternalsVisibleTo Include="Tests.contract" />
    <InternalsVisibleTo Include="Tests.integration" />
    <InternalsVisibleTo Include="Tests.prohibitions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules.Brokerage\Modules.Brokerage.csproj" />
    <ProjectReference Include="..\Modules.Listings\Modules.Listings.csproj" />
    <ProjectReference Include="..\Modules.Media\Modules.Media.csproj" />
    <ProjectReference Include="..\Modules.Content\Modules.Content.csproj" />
    <ProjectReference Include="..\Modules.Audit\Modules.Audit.csproj" />
    <ProjectReference Include="..\Libs.Ai\Libs.Ai.csproj" />
    <ProjectReference Include="..\Libs.Compliance\Libs.Compliance.csproj" />
    <ProjectReference Include="..\Libs.Reso\Libs.Reso.csproj" />
    <ProjectReference Include="..\Libs.Mls\Libs.Mls.csproj" />
    <ProjectReference Include="..\Pipeline\Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Prompts are content, not code, but they must travel with the published output: the prompt
      registry loads them from the content root at startup and the host refuses to serve traffic
      if a hash no longer matches (Principle VIII.5). A publish that left them behind would make
      every AI task unavailable.
    -->
    <Content Include="..\prompts\**\*" LinkBase="prompts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
