<Project Sdk="Microsoft.NET.Sdk">

  <!--
    T054 — the AI evaluation harness (Principle VIII.4, FR-059).

    A console tool rather than part of the API host on purpose: it runs on an operator's
    machine or in CI, against a model before that model is allowed to serve traffic, and it is
    the only writer of ai_model_registry.eval_status. Keeping it out of the host means no request
    path in the API can reach the code that records an evaluation as passed.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AiEval</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests.unit" />
    <InternalsVisibleTo Include="Tests.integration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same writer the API uses, so a harness record hashes exactly like any other. -->
    <ProjectReference Include="..\..\Modules.Audit\Modules.Audit.csproj" />
  </ItemGroup>

</Project>
