<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testcontainers.PostgreSql was removed rather than left unused. These tests verify RLS
    policies, SECURITY DEFINER functions, per-column GRANTs and storage-bucket policies, none
    of which exist in a bare postgres image: they need the auth, storage and extensions the
    Supabase CLI stack provides. Testing against a hand-rebuilt imitation of the deployment
    target would be weaker than testing against the target. See tests/integration/SupabaseDatabase.cs.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The real API host and its test token signer, shared with the contract suite rather than
      copied: flows that cross the API and storage (T070, T071) must run against the same host
      composition the contract tests verify, not a second hand-maintained one.
    -->
    <Compile Include="..\contract\Infrastructure\*.cs" LinkBase="ContractInfrastructure" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Api\Api.csproj" />
    <ProjectReference Include="..\..\tools\AiEval\AiEval.csproj" />
    <ProjectReference Include="..\..\Modules.Media\Modules.Media.csproj" />
  </ItemGroup>

</Project>