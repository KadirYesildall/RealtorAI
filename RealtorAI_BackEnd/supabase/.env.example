# Copy this file to `.env` (git-ignored) in this same directory before running `supabase start`
# with Google OAuth enabled. See specs/001-auth-base-dashboard/quickstart.md for how to obtain
# these values from the Google Cloud Console, and flip `[auth.external.google] enabled` to
# `true` in config.toml once they're set.

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
